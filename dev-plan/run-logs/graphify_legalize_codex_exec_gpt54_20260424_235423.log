import json, os, math, subprocess
from pathlib import Path
repo = Path('/Users/hwanchoi/projects/claude-code/graphify')
root = repo / 'data/legalize-kr'
env = os.environ.copy()
env['PYTHONPATH'] = str(repo) + (':' + env['PYTHONPATH'] if env.get('PYTHONPATH') else '')
code = '''import json
from graphify.cache import check_semantic_cache
from pathlib import Path

detect = json.loads(Path('graphify-out/.graphify_detect.json').read_text())
all_files = [f for files in detect['files'].values() for f in files]
cached_nodes, cached_edges, cached_hyperedges, uncached = check_semantic_cache(all_files)
if cached_nodes or cached_edges or cached_hyperedges:
    Path('graphify-out/.graphify_cached.json').write_text(json.dumps({'nodes': cached_nodes, 'edges': cached_edges, 'hyperedges': cached_hyperedges}))
Path('graphify-out/.graphify_uncached.txt').write_text('\\\\n'.join(uncached))
print(json.dumps({
    'all_files': len(all_files),
    'cached_files': len(all_files) - len(uncached),
    'uncached_files': len(uncached),
    'cached_nodes': len(cached_nodes),
    'cached_edges': len(cached_edges),
    'cached_hyperedges': len(cached_hyperedges),
}))'''
r = subprocess.run(['python3.11', '-c', code], cwd=root, env=env, capture_output=True, text=True)
print(r.stdout)
if r.stderr:
    print(r.stderr)
if r.returncode "'!= 0:
    raise SystemExit(r.returncode)
info = json.loads(r.stdout)
uncached = info['"'uncached_files']
agents = math.ceil(uncached / 22) if uncached else 0
print(json.dumps({'estimated_agents': agents, 'estimated_seconds': agents * 45}, ensure_ascii=False))
