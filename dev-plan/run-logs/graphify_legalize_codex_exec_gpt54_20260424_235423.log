"nodes\":[\"node_id1\",\"node_id2\",\"node_id3\"],\"relation\":\"participate_in|implement|form\",\"confidence\":\"EXTRACTED|INFERRED\",\"confidence_score\":0.75,\"source_file\":\"relative/path\"}],\"input_tokens\":0,\"output_tokens\":0}\\n''', encoding='utf-8')
