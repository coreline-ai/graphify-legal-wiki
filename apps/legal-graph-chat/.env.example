# Legal Graph Chat local-first configuration scaffold.
# Copy to .env for local experiments. Do not commit real secrets or private corpus paths.

# API listener. Keep host loopback for local development.
LEGAL_GRAPH_API_HOST=127.0.0.1
LEGAL_GRAPH_API_PORT=8765

# Frontend API target used by Vite.
VITE_API_BASE_URL=http://127.0.0.1:8765

# Comma-separated browser origins allowed to call the backend.
# Keep this narrow; do not use "*" when the source viewer is enabled.
LEGAL_GRAPH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Legalize source viewer settings. The viewer must remain read-only and path-whitelisted.
LEGAL_GRAPH_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_SOURCE_ROOT=../../data/legalize-kr
LEGAL_GRAPH_SOURCE_MAX_CHARS=40000

# Precedent corpus settings. Mount this as a read-only volume outside the app bundle.
LEGAL_GRAPH_PRECEDENT_ROOT=../../data/precedent-kr
LEGAL_GRAPH_PRECEDENT_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_PRECEDENT_SOURCE_MAX_CHARS=40000
LEGAL_GRAPH_PRECEDENT_SEARCH_LIMIT=20

# LLM answer generation is disabled by default. The safe default is deterministic,
# source-grounded/extractive answers only.
LEGAL_GRAPH_LLM_ENABLED=false
LEGAL_GRAPH_LLM_PROVIDER=coreline-codex-proxy
LEGAL_GRAPH_LLM_MODEL=
LEGAL_GRAPH_LLM_MAX_CONTEXT_ITEMS=24
LEGAL_GRAPH_LLM_MAX_OUTPUT_TOKENS=1024

# Index/storage scaffold. The current local app can run filesystem-only; production
# deployments may add Postgres + pgvector/PGroonga indexes behind a private network.
LEGAL_GRAPH_INDEX_BACKEND=filesystem
LEGAL_GRAPH_INDEX_PRELOAD=true
LEGAL_GRAPH_INDEX_REFRESH_SECONDS=0
LEGAL_GRAPH_DATABASE_URL=
LEGAL_GRAPH_DATABASE_URL_FILE=
LEGAL_GRAPH_PGVECTOR_ENABLED=false
LEGAL_GRAPH_PGROONGA_ENABLED=false

# Auth/private-network scaffold used by deploy/compose.prod.yml and nginx.
# Local development normally leaves auth disabled and binds only to loopback.
PUBLIC_BASE_URL=http://127.0.0.1:5173
LEGAL_GRAPH_AUTH_REQUIRED=false
LEGAL_GRAPH_AUTH_PROXY=oauth2-proxy
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=http://127.0.0.1:8080/oauth2/callback
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_EMAIL_DOMAINS=

# Endpoint rate-limit runbook values. nginx.conf is the enforcement source.
LEGAL_GRAPH_RATE_LIMIT_API_GENERAL=120r/m
LEGAL_GRAPH_RATE_LIMIT_API_ANSWER=12r/m
LEGAL_GRAPH_RATE_LIMIT_API_SOURCE=30r/m
LEGAL_GRAPH_RATE_LIMIT_API_PRECEDENT_SOURCE=20r/m
LEGAL_GRAPH_RATE_LIMIT_API_FULL_3D=6r/m

# Optional Coreline Codex proxy. Keep Codex auth/token material isolated in the
# proxy; the Legal Graph backend should only receive the internal URL + token file.
CORELINE_CODEX_PROXY_URL=http://coreline-codex-proxy:8787
CORELINE_CODEX_PROXY_TOKEN_FILE=
