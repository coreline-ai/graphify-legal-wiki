        "question": "민법 계약",
        "mode": "deterministic",
        "answer": "source evidence만 사용한 deterministic answer",
        "summary": "질문에 대한 제한 subgraph와 evidence summary",
        "citations": [],
        "evidence": [],
        "graph": {},
        "disclaimer": "graph/source evidence 탐색 결과이며 법률 자문이 아닙니다.",
        "provider": null,
        "model": null,
        "llm_status": "not_requested",
        "validated_citations": [],
        "warnings": []
      }
