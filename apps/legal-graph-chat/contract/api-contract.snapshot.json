{
  "version": 1,
  "description": "Golden API response contract for Legal Graph Chat. Tests validate required response keys and representative nested shapes for graph, answer, source, and precedent APIs against this snapshot.",
  "models": {
    "ApiError": {
      "required_fields": [
        "code",
        "message",
        "detail",
        "recover_action"
      ],
      "example": {
        "code": "SOURCE_FORBIDDEN",
        "message": "source path must be relative and cannot contain '..'",
        "detail": null,
        "recover_action": "Only relative files under configured source corpus roots can be opened."
      }
    },
    "GraphNodeDTO": {
