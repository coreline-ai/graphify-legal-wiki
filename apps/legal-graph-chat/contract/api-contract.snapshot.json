    "GET /health",
    "POST /query",
    "POST /answer",
    "GET /explain",
    "GET /path",
    "GET /subgraph",
    "POST /subgraph/3d",
    "GET /communities/3d",
    "GET /graph/full-3d",
    "GET /suggested-questions",
    "GET /source",
    "GET /precedents/health",
    "GET /precedents/search?q=...",
    "GET /precedents/source?path=..."
