# Backend-only Legal Graph Chat configuration scaffold.
# Paths below are relative to apps/legal-graph-chat/backend when used from this directory.

LEGAL_GRAPH_API_HOST=127.0.0.1
LEGAL_GRAPH_API_PORT=8765
LEGAL_GRAPH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Read-only source viewers. Keep enabled only for trusted local/authenticated users.
LEGAL_GRAPH_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_SOURCE_ROOT=../../../data/legalize-kr
LEGAL_GRAPH_SOURCE_MAX_CHARS=40000
LEGAL_GRAPH_PRECEDENT_ROOT=../../../data/precedent-kr
LEGAL_GRAPH_PRECEDENT_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_PRECEDENT_SOURCE_MAX_CHARS=40000
LEGAL_GRAPH_PRECEDENT_SEARCH_LIMIT=20

# Disabled-by-default LLM scaffold.
LEGAL_GRAPH_LLM_ENABLED=false
LEGAL_GRAPH_LLM_PROVIDER=coreline-codex-proxy
LEGAL_GRAPH_LLM_MODEL=
LEGAL_GRAPH_LLM_MAX_CONTEXT_ITEMS=24
LEGAL_GRAPH_LLM_MAX_OUTPUT_TOKENS=1024

# Internal index/storage scaffold. Leave filesystem-only for local runs unless a
# private Postgres service and migrations are explicitly configured.
LEGAL_GRAPH_INDEX_BACKEND=filesystem
LEGAL_GRAPH_INDEX_PRELOAD=true
LEGAL_GRAPH_INDEX_REFRESH_SECONDS=0
LEGAL_GRAPH_DATABASE_URL=
LEGAL_GRAPH_DATABASE_URL_FILE=
LEGAL_GRAPH_PGVECTOR_ENABLED=false
LEGAL_GRAPH_PGROONGA_ENABLED=false

# Auth/rate-limit deployment contract. These are mostly enforced by nginx in
# deploy/ and are included here so backend operators see the same names.
LEGAL_GRAPH_AUTH_REQUIRED=false
LEGAL_GRAPH_AUTH_PROXY=oauth2-proxy
LEGAL_GRAPH_RATE_LIMIT_API_GENERAL=120r/m
LEGAL_GRAPH_RATE_LIMIT_API_ANSWER=12r/m
LEGAL_GRAPH_RATE_LIMIT_API_SOURCE=30r/m
LEGAL_GRAPH_RATE_LIMIT_API_PRECEDENT_SOURCE=20r/m
LEGAL_GRAPH_RATE_LIMIT_API_FULL_3D=6r/m

# Optional Coreline Codex proxy. The backend must not read ~/.codex/auth.json;
# use an internal proxy URL and a bearer-token file if/when LLM mode is enabled.
CORELINE_CODEX_PROXY_URL=http://coreline-codex-proxy:8787
CORELINE_CODEX_PROXY_TOKEN_FILE=
