# Legal Graph Chat production deployment example.
# Copy to .env.production and fill values with deployment-specific, non-committed data.
# Do not commit real secrets, private corpus paths, or provider tokens.

# Public edge and frontend build target.
PUBLIC_BASE_URL=https://legal-graph.example.com
VITE_API_BASE_URL=https://legal-graph.example.com/api
LEGAL_GRAPH_ALLOWED_ORIGINS=https://legal-graph.example.com
LEGAL_GRAPH_INGRESS_BIND=0.0.0.0
LEGAL_GRAPH_INGRESS_PORT=8080

# Optional image overrides.
LEGAL_GRAPH_NGINX_IMAGE=nginx:1.27-alpine
LEGAL_GRAPH_FRONTEND_IMAGE=legal-graph-chat-frontend:prod
LEGAL_GRAPH_BACKEND_IMAGE=legal-graph-chat-backend:prod
LEGAL_GRAPH_POSTGRES_IMAGE=pgvector/pgvector:pg16
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.7.1

# Read-only host corpus mounts. Prefer absolute paths in production.
LEGAL_GRAPH_LEGALIZE_CORPUS_ROOT=/srv/legal-corpus/legalize-kr
LEGAL_GRAPH_PRECEDENT_CORPUS_ROOT=/srv/legal-corpus/precedent-kr
LEGAL_GRAPH_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_SOURCE_MAX_CHARS=40000
LEGAL_GRAPH_PRECEDENT_SOURCE_VIEWER_ENABLED=true
LEGAL_GRAPH_PRECEDENT_SOURCE_MAX_CHARS=40000
LEGAL_GRAPH_PRECEDENT_SEARCH_LIMIT=20
LEGAL_GRAPH_METRICS_ENABLED=true
LEGAL_GRAPH_METRICS_PUBLIC=false

# LLM answer generation. Keep disabled until source grounding and provider logging are reviewed.
LEGAL_GRAPH_LLM_ENABLED=false
LEGAL_GRAPH_LLM_PROVIDER=coreline-codex-proxy
LEGAL_GRAPH_LLM_MODEL=
LEGAL_GRAPH_LLM_MAX_CONTEXT_ITEMS=24
LEGAL_GRAPH_LLM_MAX_OUTPUT_TOKENS=1024

# Internal index/storage scaffold. Current app can run filesystem-only; DB is for future indexing work.
LEGAL_GRAPH_INDEX_BACKEND=filesystem
LEGAL_GRAPH_INDEX_PRELOAD=true
LEGAL_GRAPH_INDEX_REFRESH_SECONDS=0
LEGAL_GRAPH_PGVECTOR_ENABLED=false
LEGAL_GRAPH_PGROONGA_ENABLED=false
LEGAL_GRAPH_DATABASE_URL_HOST_FILE=./secrets/legal_graph_database_url

# Postgres internal-only service.
POSTGRES_DB=legal_graph
POSTGRES_USER=legal_graph
POSTGRES_PASSWORD_HOST_FILE=./secrets/postgres_password

# oauth2-proxy. Values below are placeholders; set real values through a secret manager or local env file.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://legal-graph.example.com/oauth2/callback
OAUTH2_PROXY_OIDC_ISSUER_URL=https://accounts.google.com
OAUTH2_PROXY_EMAIL_DOMAINS=example.com

# nginx rate-limit defaults mirrored from nginx.conf for runbook visibility.
LEGAL_GRAPH_RATE_LIMIT_API_GENERAL=120r/m
LEGAL_GRAPH_RATE_LIMIT_API_ANSWER=12r/m
LEGAL_GRAPH_RATE_LIMIT_API_SOURCE=30r/m
LEGAL_GRAPH_RATE_LIMIT_API_PRECEDENT_SOURCE=20r/m
LEGAL_GRAPH_RATE_LIMIT_API_FULL_3D=6r/m

# Optional Coreline Codex proxy profile. Backend never receives ~/.codex/auth.json.
CORELINE_CODEX_PROXY_URL=http://coreline-codex-proxy:8787
CORELINE_CODEX_PROXY_IMAGE=ghcr.io/example/coreline-codex-proxy:replace-me
CORELINE_CODEX_PROXY_MODEL=gpt-5.1-codex
CORELINE_CODEX_AUTH_DIR=/srv/coreline-codex-auth
CORELINE_CODEX_PROXY_TOKEN_HOST_FILE=./secrets/coreline_codex_proxy_token
